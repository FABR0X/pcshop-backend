# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgres://postgres:abc123@localhost:5432/pcshop

# --- JWT ---
# Signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never commit the real value: it goes in .env (git-ignored).
JWT_SECRET=change-me-generate-a-long-random-string-before-running
JWT_EXPIRES_IN=1h
JWT_ISSUER=pcshop-api
JWT_AUDIENCE=pcshop-frontend

# --- LDAP ---
LDAP_URL=ldap://localhost:1389
LDAP_BASE_DN=dc=lab,dc=local
LDAP_SVC_DN=cn=svc-pcshop,ou=Services,dc=lab,dc=local
LDAP_SVC_PASSWORD=SvcPcshop-@2026

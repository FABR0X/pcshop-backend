{
  "name": "pcshop-backend",
  "version": "1.0.0",
  "description": "JWT-authenticated REST API for the PC components dashboard. LDAP authenticates the user, the backend signs a JWT and every product operation requires it as a Bearer token.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "keywords": [
    "jwt",
    "ldap",
    "bearer-token",
    "express",
    "security"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ldapjs": "^3.0.7",
    "pg": "^8.23.0"
  }
}
